---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SpeakeBanner from '../components/SpeakeBanner.astro';
import logoRoxo from '../assets/logo-speake-roxo.svg';
import logoBranco from '../assets/logo-speake-branco.svg';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	jsonLd?: Record<string, unknown>;
	/** layout largo (artigo com sidebar) — troca o contêiner de 4xl para 6xl */
	wide?: boolean;
}

const {
	title,
	description,
	image,
	imageAlt,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	jsonLd,
	wide = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteName = 'Speake Blog';
const fullTitle = `${title} · ${siteName}`;

// Scrapers de preview (WhatsApp, Facebook, X, LinkedIn) não renderizam SVG, e as
// ilustrações dos posts são SVG. Para essas, apontamos para o PNG 1200x630 equivalente
// gerado por scripts/gen-og-images.mjs em /og/<nome>.png — o nome base sobrevive ao
// hash que o Astro adiciona ("masterizacao.<hash>.svg" → "masterizacao").
const ogImagePath = image?.endsWith('.svg')
	? `/og/${image.split('/').pop()!.split('.')[0]}.png`
	: image;

// Todas as imagens de OG servidas hoje são 1200x630 (padrão ou derivada do post),
// então declaramos dimensões e tipo sempre.
const ogImage = new URL(ogImagePath ?? '/og-default.png', Astro.site ?? Astro.url.origin).toString();
const usingDefaultImage = !image;
const ogImageAlt = imageAlt ?? (usingDefaultImage ? `${siteName} — podcasting, produção musical e masterização` : title);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Anti-FOUC: precisa rodar de forma síncrona, antes do primeiro paint do
			// <body>, por isso é inline (não type="module") e sem defer/async.
			// Valores fixos apenas ('light'/'dark'); getItem nunca é usado para HTML/innerHTML,
			// só comparado a strings literais e passado a setAttribute (sem risco de injeção).
			(function () {
				var STORAGE_KEY = 'theme';
				var stored = localStorage.getItem(STORAGE_KEY);
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var dark = stored === 'dark' || (stored !== 'light' && prefersDark);
				if (dark) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#6d28d9" />
		<meta name="generator" content={Astro.generator} />

		<!-- Tipografia: Clash Display (títulos) + Satoshi (corpo) via Fontshare,
		     JetBrains Mono (rótulos e timecodes) via Google Fonts. -->
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
			rel="stylesheet"
		/>

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="pt_BR" />
		{type === 'article' && publishedTime && (
			<meta property="article:published_time" content={publishedTime.toISOString()} />
		)}
		{type === 'article' && modifiedTime && (
			<meta property="article:modified_time" content={modifiedTime.toISOString()} />
		)}
		{type === 'article' && <meta property="article:author" content="https://speake.com.br" />}
		{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="min-h-screen flex flex-col">
		<!-- fita corrida: progresso de leitura -->
		<div class="progress-top" aria-hidden="true"><div class="progress-top__fill" id="readbar"></div></div>

		<SpeakeBanner />

		<!-- sem backdrop-blur: filtro de fundo em elemento sticky encarece cada
		     frame de rolagem no mobile; papel 97% opaco dá o mesmo efeito -->
		<header class="sticky top-0 z-50 border-b border-(--line) bg-(--color-paper)/97">
			<nav
				aria-label="Navegação principal"
				class:list={['mx-auto flex items-center justify-between gap-3 px-4 py-3', wide ? 'max-w-6xl' : 'max-w-4xl']}
			>
				<a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Speake Blog — início">
					<img src={logoRoxo.src} alt="" aria-hidden="true" class="h-6 w-auto block dark-hide" />
					<img src={logoBranco.src} alt="" aria-hidden="true" class="h-6 w-auto hidden dark-show" />
					<span class="t-micro text-ink-faint mt-1">/ blog</span>
				</a>
				<div class="flex items-center gap-1 sm:gap-3">
					<a
						href="/tags"
						class="t-micro text-ink-soft hover:text-signal transition-colors duration-150 px-2 py-2"
					>
						Categorias
					</a>
					<ThemeToggle />
					<a href="https://speake.com.br" target="_blank" rel="noopener" class="btn btn--primary btn--sm hidden sm:inline-flex">
						speake.com.br
					</a>
				</div>
			</nav>
		</header>

		<main class:list={['flex-1 w-full mx-auto px-4 pt-10 pb-16', wide ? 'max-w-6xl' : 'max-w-4xl']}>
			<slot />
		</main>

		<footer class="footer-panel mt-auto">
			<div class:list={['mx-auto w-full px-4 py-10', wide ? 'max-w-6xl' : 'max-w-4xl']}>
				<div class="grid gap-8 sm:grid-cols-3">
					<div class="sm:col-span-1">
						<a href="/" class="inline-flex items-center gap-2.5" aria-label="Speake Blog — início">
							<img src={logoRoxo.src} alt="" aria-hidden="true" class="h-6 w-auto block dark-hide" />
							<img src={logoBranco.src} alt="" aria-hidden="true" class="h-6 w-auto hidden dark-show" />
							<span class="t-micro text-ink-faint mt-1">/ blog</span>
						</a>
						<p class="text-sm mt-3.5 text-ink-soft leading-relaxed max-w-xs">
							Áudio, podcasting e produção sonora, na prática — escrito por quem grava,
							mixa e publica.
						</p>
					</div>

					<nav aria-label="Navegação do rodapé" class="flex flex-col">
						<h2 class="t-micro text-ink-faint mb-2">Navegue</h2>
						<a href="/" class="footer-link">Início</a>
						<a href="/tags" class="footer-link">Categorias</a>
						<a href="/rss.xml" class="footer-link">Feed RSS</a>
					</nav>

					<div class="flex flex-col">
						<h2 class="t-micro text-ink-faint mb-2">Estúdio</h2>
						<p class="text-sm text-ink-soft leading-relaxed mb-3.5">
							A Speake é um estúdio de produção de áudio, podcast e narração
							profissional.
						</p>
						<a
							href="https://speake.com.br"
							target="_blank"
							rel="noopener"
							class="btn btn--outline btn--sm self-start"
						>
							speake.com.br
						</a>
					</div>
				</div>

				<div
					class="border-t border-(--footer-line) mt-8 pt-5 flex flex-wrap items-center justify-between gap-3"
				>
					<p class="font-mono-panel text-xs text-ink-faint">
						© {new Date().getFullYear()} Speake · blog.speake.com.br
					</p>
					<div class="flex items-end gap-1 h-3.5 animate-equalize" aria-hidden="true">
						<span class="w-1 h-full rounded-full bg-(--color-brand-400)"></span>
						<span class="w-1 h-3/4 rounded-full bg-(--color-brand-300)"></span>
						<span class="w-1 h-full rounded-full bg-(--color-brand-400)"></span>
						<span class="w-1 h-1/2 rounded-full bg-(--color-brand-300)"></span>
					</div>
				</div>
			</div>
		</footer>

		<style>
			/* troca de logo por tema (violeta no claro, branco no escuro) */
			:global([data-theme="dark"]) .dark-hide {
				display: none;
			}
			:global([data-theme="dark"]) .dark-show {
				display: block;
			}
		</style>

		<script>
			// Barra de progresso de leitura — largura acompanha o scroll da página.
			// Trabalho de layout (scrollHeight) só dentro de requestAnimationFrame,
			// no máximo uma vez por frame: eventos de scroll no mobile disparam em
			// rajada e ler layout em cada um deles trava a rolagem.
			const bar = document.getElementById('readbar');
			let ticking = false;
			function update() {
				if (bar) {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					bar.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
				}
				ticking = false;
			}
			function onScroll() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			}
			update();
			window.addEventListener('scroll', onScroll, { passive: true });
		</script>
	</body>
</html>
