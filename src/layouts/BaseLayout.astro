---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SpeakeBanner from '../components/SpeakeBanner.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	image,
	imageAlt,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteName = 'Speake Blog';
const fullTitle = `${title} · ${siteName}`;

// Scrapers de preview (WhatsApp, Facebook, X, LinkedIn) não renderizam SVG, e as
// ilustrações dos posts são SVG. Para essas, apontamos para o PNG 1200x630 equivalente
// gerado por scripts/gen-og-images.mjs em /og/<nome>.png — o nome base sobrevive ao
// hash que o Astro adiciona ("masterizacao.<hash>.svg" → "masterizacao").
const ogImagePath = image?.endsWith('.svg')
	? `/og/${image.split('/').pop()!.split('.')[0]}.png`
	: image;

// Todas as imagens de OG servidas hoje são 1200x630 (padrão ou derivada do post),
// então declaramos dimensões e tipo sempre.
const ogImage = new URL(ogImagePath ?? '/og-default.png', Astro.site ?? Astro.url.origin).toString();
const usingDefaultImage = !image;
const ogImageAlt = imageAlt ?? (usingDefaultImage ? `${siteName} — podcasting, produção musical e masterização` : title);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Anti-FOUC: precisa rodar de forma síncrona, antes do primeiro paint do
			// <body>, por isso é inline (não type="module") e sem defer/async.
			// Valores fixos apenas ('light'/'dark'); getItem nunca é usado para HTML/innerHTML,
			// só comparado a strings literais e passado a setAttribute (sem risco de injeção).
			(function () {
				var STORAGE_KEY = 'theme';
				var stored = localStorage.getItem(STORAGE_KEY);
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				var dark = stored === 'dark' || (stored !== 'light' && prefersDark);
				if (dark) {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#6711D5" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="pt_BR" />
		{type === 'article' && publishedTime && (
			<meta property="article:published_time" content={publishedTime.toISOString()} />
		)}
		{type === 'article' && modifiedTime && (
			<meta property="article:modified_time" content={modifiedTime.toISOString()} />
		)}
		{type === 'article' && <meta property="article:author" content="https://speake.com.br" />}
		{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="min-h-screen flex flex-col">
		<SpeakeBanner />
		<header class="border-b border-studio-border bg-studio-surface">
			<div class="max-w-3xl mx-auto px-4 py-5 flex items-center justify-between">
				<a href="/" class="font-mono-panel text-studio-amber text-lg tracking-tight hover:text-studio-mint transition-colors duration-150">
					speake<span class="text-studio-text-muted">.blog</span>
				</a>
				<div class="flex items-center gap-4">
					<nav aria-label="Navegação principal" class="font-mono-panel text-sm">
						<a href="/tags" class="text-studio-text-muted hover:text-studio-amber transition-colors duration-150">tags</a>
					</nav>
					<ThemeToggle />
				</div>
			</div>
		</header>

		<main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
			<slot />
		</main>

		<footer class="border-t border-studio-border bg-studio-surface mt-auto">
			<div class="max-w-3xl mx-auto px-4 py-6 font-mono-panel text-xs text-studio-text-muted">
				<p>© {new Date().getFullYear()} speake.blog — conteúdo sobre áudio, podcasting e produção sonora.</p>
			</div>
		</footer>
	</body>
</html>
