---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';
import { formatPostDateShort } from '../lib/formatDate';
import defaultCover from '../assets/posts/speake-default.svg';

interface Props {
	post: CollectionEntry<'posts'>;
	/** posição na listagem — vira o número de faixa (TRK 01, TRK 02…) */
	index?: number;
}

const { post, index } = Astro.props;
const formattedDate = formatPostDateShort(post.data.pubDate);

// Tempo de leitura estimado a 200 palavras/min.
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const trackNumber = index !== undefined ? String(index + 1).padStart(2, '0') : undefined;

// Todo cartão tem capa: sem ilustração própria, cai na capa da marca. Cartões
// com e sem imagem na mesma listagem quebravam o ritmo da grade.
const cover = post.data.image?.src ?? defaultCover;
---

<article
	class="post-card sheet sheet--hover relative overflow-hidden flex flex-col"
	data-title={post.data.title.toLowerCase()}
	data-tags={post.data.tags.join(',')}
>
	<img
		src={cover.src}
		alt=""
		aria-hidden="true"
		loading="lazy"
		decoding="async"
		class="w-full aspect-[1200/630] object-cover border-b border-(--line)"
	/>
	<div class="p-5 flex flex-col flex-1">
		<p class="font-mono-panel text-[0.6875rem] tracking-[0.08em] uppercase text-ink-faint flex items-center gap-2">
			{trackNumber && <span class="text-signal font-semibold">TRK {trackNumber}</span>}
			{trackNumber && <span aria-hidden="true" class="text-(--line-strong)">|</span>}
			<time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
			<span aria-hidden="true" class="text-(--line-strong)">|</span>
			<span>{readingMinutes} min</span>
		</p>
		<h2 class="font-display font-semibold text-xl mt-2.5 mb-2 leading-snug">
			<a
				href={`/posts/${post.id}/`}
				class="hover:text-signal transition-colors duration-150 after:absolute after:inset-0 after:content-[''] after:z-0"
			>
				{post.data.title}
			</a>
		</h2>
		<p class="text-sm text-ink-soft mb-4 leading-relaxed flex-1">{post.data.description}</p>
		<div class="relative z-10 flex flex-wrap gap-1.5">
			{post.data.tags.map((tag) => <TagBadge tag={tag} />)}
		</div>
	</div>
</article>
