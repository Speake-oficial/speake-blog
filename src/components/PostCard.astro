---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';
import { formatPostDateShort } from '../lib/formatDate';

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const formattedDate = formatPostDateShort(post.data.pubDate);

// Tempo de leitura estimado a 200 palavras/min — metadado útil pro leitor e
// sinal de profundidade de conteúdo pro card.
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const cover = post.data.image;

// Capa fallback para posts sem ilustração: gradiente aurora com variação
// determinística por post (hash simples do id), pra manter o ritmo do grid
// sem que todos os fallbacks fiquem idênticos.
const gradients = [
	'linear-gradient(135deg, #6d28d9, #a78bfa)',
	'linear-gradient(135deg, #4c1d95, #8b5cf6)',
	'linear-gradient(135deg, #5b21b6, #c4b0fb)',
];
const hash = [...post.id].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
const fallbackGradient = gradients[hash % gradients.length];
---

<article
	class="post-card glass card-hover relative rounded-[1.75rem] overflow-hidden flex flex-col"
	data-title={post.data.title.toLowerCase()}
	data-tags={post.data.tags.join(',')}
>
	{cover ? (
		<img
			src={cover.src.src}
			alt=""
			aria-hidden="true"
			loading="lazy"
			decoding="async"
			class="w-full aspect-[1200/630] object-cover"
		/>
	) : (
		<div
			aria-hidden="true"
			class="w-full aspect-[1200/630] flex items-center justify-center"
			style={`background: ${fallbackGradient}`}
		>
			<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/></svg>
		</div>
	)}
	<div class="p-5 sm:p-6 flex flex-col flex-1">
		<p class="font-mono-panel text-xs text-ink-faint flex items-center gap-2">
			<time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
			<span aria-hidden="true">·</span>
			<span>{readingMinutes} min de leitura</span>
		</p>
		<h2 class="font-display font-semibold text-xl mt-2 mb-2 leading-snug">
			<a
				href={`/posts/${post.id}/`}
				class="hover:text-brand-600 transition-colors duration-150 after:absolute after:inset-0 after:content-[''] after:z-0"
			>
				{post.data.title}
			</a>
		</h2>
		<p class="text-sm text-ink-soft mb-4 leading-relaxed flex-1">{post.data.description}</p>
		<div class="relative z-10 flex flex-wrap gap-2">
			{post.data.tags.map((tag) => <TagBadge tag={tag} />)}
		</div>
	</div>
</article>
