---
interface Props {
	tag: string;
	count?: number;
}

const { tag, count } = Astro.props;

// Label legível a partir do slug (ex.: "producao-musical" -> "produção musical")
// — mapeamento explícito em vez de replace genérico, porque acentos não se recuperam
// de um slug sem acento por regra mecânica.
const LABELS: Record<string, string> = {
	podcasting: 'podcasting',
	'producao-musical': 'produção musical',
	masterizacao: 'masterização',
	'equipamentos-de-audio': 'equipamentos de áudio',
	narracao: 'narração',
	mixagem: 'mixagem',
	'audio-livros': 'áudio-livros',
	microfones: 'microfones',
	'home-studio': 'home studio',
};

const label = LABELS[tag] ?? tag;
---

<a
	href={`/tags/${tag}/`}
	class="inline-flex items-center gap-1.5 font-mono-panel text-xs uppercase tracking-wide px-2.5 py-1 rounded-sm border border-studio-border bg-studio-surface-raised text-studio-text-muted hover:border-studio-amber hover:text-studio-amber transition-colors duration-150"
	data-tag={tag}
>
	{label}
	{count !== undefined && <span class="text-studio-amber-dim">({count})</span>}
</a>
