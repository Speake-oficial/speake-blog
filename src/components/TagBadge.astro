---
import { getTagLabel } from '../lib/tagLabels';

interface Props {
	tag: string;
	count?: number;
}

const { tag, count } = Astro.props;

const label = getTagLabel(tag);
---

<a
	href={`/tags/${tag}/`}
	class="inline-flex items-center gap-1.5 font-mono-panel text-xs uppercase tracking-wide px-2.5 py-1 rounded-sm border border-studio-border bg-studio-surface-raised text-studio-text-muted hover:border-studio-amber hover:text-studio-amber transition-colors duration-150"
	data-tag={tag}
>
	{label}
	{count !== undefined && <span class="text-studio-amber-dim">({count})</span>}
</a>
