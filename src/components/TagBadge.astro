---
import { getTagLabel } from '../lib/tagLabels';

interface Props {
	tag: string;
	count?: number;
}

const { tag, count } = Astro.props;

const label = getTagLabel(tag);
---

<a href={`/tags/${tag}/`} class="chip" data-tag={tag}>
	{label}
	{count !== undefined && <span class="opacity-60 font-normal">({count})</span>}
</a>
