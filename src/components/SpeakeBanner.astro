---
// Chamada para o site institucional da Speake, sempre visível durante a navegação.
// Vive como faixa no topo da página enquanto está no fluxo normal; quando o scroll
// a leva pra fora da viewport, um IntersectionObserver troca pra uma versão fixa
// lateral, pra continuar acompanhando o usuário sem precisar de scroll/position
// fixed permanente (que cobriria conteúdo logo no topo da página).
---

<a
	href="https://speake.com.br"
	target="_blank"
	rel="noopener"
	id="speake-banner-top"
	class="block bg-gradient-to-r from-brand-700 via-brand-600 to-brand-700 text-white text-xs sm:text-sm font-semibold tracking-wide text-center py-2 px-4 hover:from-brand-600 hover:via-brand-500 hover:to-brand-600 transition-colors duration-200"
>
	🎙️ Speake — produção de áudio, podcast e narração profissional. Conheça <span class="underline underline-offset-2 decoration-white/60">speake.com.br</span> →
</a>

<a
	href="https://speake.com.br"
	target="_blank"
	rel="noopener"
	id="speake-banner-side"
	aria-hidden="true"
	class="hidden fixed right-0 top-1/2 -translate-y-1/2 z-50 [writing-mode:vertical-rl] bg-gradient-to-b from-brand-600 to-brand-700 text-white text-xs font-semibold tracking-wide py-3 px-2 rounded-l-xl shadow-lg shadow-brand-900/40 hover:from-brand-500 hover:to-brand-600 transition-colors duration-200"
>
	🎙️ Conheça a Speake →
</a>

<script>
	const top = document.getElementById('speake-banner-top');
	const side = document.getElementById('speake-banner-side');

	if (top && side) {
		const observer = new IntersectionObserver(
			([entry]) => {
				const topVisible = entry.isIntersecting;
				side.classList.toggle('hidden', topVisible);
				side.setAttribute('aria-hidden', String(topVisible));
			},
			{ threshold: 0 }
		);
		observer.observe(top);
	}
</script>
