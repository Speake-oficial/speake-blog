---
// Chamada para o site institucional da Speake, sempre visível durante a navegação.
// Vive como faixa no topo da página enquanto está no fluxo normal; quando o scroll
// a leva pra fora da viewport, um IntersectionObserver troca pra uma versão fixa
// lateral, pra continuar acompanhando o usuário sem precisar de scroll/position
// fixed permanente (que cobriria conteúdo logo no topo da página).
---

<a
	href="https://speake.com.br"
	target="_blank"
	rel="noopener"
	id="speake-banner-top"
	class="flex items-center justify-center gap-2 bg-(--deep) text-white font-mono-panel text-[0.6875rem] sm:text-xs tracking-[0.08em] uppercase text-center py-2 px-4 hover:text-white/80 transition-colors duration-150"
>
	<span class="inline-block h-1.5 w-1.5 rounded-full bg-signal" aria-hidden="true"></span>
	Speake — áudio, podcast e narração profissional
	<span class="underline underline-offset-2 decoration-white/50">speake.com.br</span> →
</a>

<a
	href="https://speake.com.br"
	target="_blank"
	rel="noopener"
	id="speake-banner-side"
	aria-hidden="true"
	class="hidden fixed right-0 top-1/2 -translate-y-1/2 z-50 [writing-mode:vertical-rl] bg-(--deep) text-white font-mono-panel text-[0.6875rem] tracking-[0.08em] uppercase py-3 px-2 rounded-l-lg border border-r-0 border-white/15 hover:text-white/80 transition-colors duration-150"
>
	Conheça a Speake →
</a>

<script>
	const top = document.getElementById('speake-banner-top');
	const side = document.getElementById('speake-banner-side');

	if (top && side) {
		const observer = new IntersectionObserver(
			([entry]) => {
				const topVisible = entry.isIntersecting;
				side.classList.toggle('hidden', topVisible);
				side.setAttribute('aria-hidden', String(topVisible));
			},
			{ threshold: 0 }
		);
		observer.observe(top);
	}
</script>
