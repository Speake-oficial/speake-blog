---
// Botão nativo de alternância de tema claro/escuro (ícones Lucide sol/lua).
// O estado inicial (atributo data-theme em <html>) já é definido por um script
// inline síncrono no <head> do BaseLayout, antes deste componente renderizar —
// aqui só lemos esse estado já presente no DOM para refletir aria-pressed/label
// corretamente no primeiro paint, sem flash de estado errado no botão.
---

<button
	id="theme-toggle"
	type="button"
	aria-pressed="false"
	aria-label="Alternar para tema escuro"
	class="inline-flex items-center justify-center h-9 w-9 rounded-lg border border-(--line) text-ink-soft hover:text-signal hover:border-(--line-strong) transition-colors duration-150"
>
	<!-- lucide: sun (visível no tema claro) -->
	<svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
	<!-- lucide: moon (visível no tema escuro) -->
	<svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>

<style>
	:global([data-theme="dark"]) #icon-sun {
		display: none;
	}
	:global([data-theme="dark"]) #icon-moon {
		display: block;
	}
</style>

<script>
	// Mesma chave de localStorage usada pelo script inline síncrono no <head>
	// (ver BaseLayout.astro) — precisa ser idêntica para o toggle e o anti-FOUC
	// concordarem sobre o estado persistido.
	const STORAGE_KEY = 'theme';
	const button = document.getElementById('theme-toggle');

	function isDark(): boolean {
		return document.documentElement.getAttribute('data-theme') === 'dark';
	}

	function syncButton() {
		if (!button) return;
		const dark = isDark();
		button.setAttribute('aria-pressed', String(dark));
		button.setAttribute('aria-label', dark ? 'Alternar para tema claro' : 'Alternar para tema escuro');
	}

	button?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		if (next === 'dark') {
			document.documentElement.setAttribute('data-theme', 'dark');
		} else {
			document.documentElement.removeAttribute('data-theme');
		}
		// Valor fixo ('light'/'dark'), nunca dado vindo do usuário — seguro contra
		// qualquer injeção via localStorage.
		localStorage.setItem(STORAGE_KEY, next);
		syncButton();
	});

	syncButton();
</script>
