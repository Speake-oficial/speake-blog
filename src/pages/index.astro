---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagBadge from '../components/TagBadge.astro';
import SearchFilter from '../components/SearchFilter.astro';
import { AUDIO_TAGS } from '../content.config';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tagsWithCount = AUDIO_TAGS.filter((tag) => tagCounts.has(tag)).map((tag) => ({
	tag,
	count: tagCounts.get(tag) ?? 0,
}));

const siteURL = (Astro.site ?? Astro.url.origin).toString();

// JSON-LD da home: WebSite + Blog + Organization (publisher) num único @graph.
// É a âncora de entidade que buscadores e motores generativos usam para ligar o
// blog à Speake (speake.com.br) — a relação de marca fica explícita, não inferida.
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteURL}#website`,
			url: siteURL,
			name: 'Speake Blog',
			description:
				'Guias práticos de podcasting, produção musical, masterização e equipamentos de áudio.',
			inLanguage: 'pt-BR',
			publisher: { '@id': 'https://speake.com.br/#organization' },
		},
		{
			'@type': 'Blog',
			'@id': `${siteURL}#blog`,
			url: siteURL,
			name: 'Speake Blog',
			inLanguage: 'pt-BR',
			publisher: { '@id': 'https://speake.com.br/#organization' },
			blogPost: posts.slice(0, 10).map((post) => ({
				'@type': 'BlogPosting',
				headline: post.data.title,
				url: new URL(`/posts/${post.id}/`, siteURL).toString(),
				datePublished: post.data.pubDate.toISOString(),
			})),
		},
		{
			'@type': 'Organization',
			'@id': 'https://speake.com.br/#organization',
			name: 'Speake',
			url: 'https://speake.com.br',
			description: 'Estúdio de produção de áudio, podcast e narração profissional.',
			logo: {
				'@type': 'ImageObject',
				url: new URL('/icon-512.png', siteURL).toString(),
				width: 512,
				height: 512,
			},
		},
	],
};
---

<BaseLayout
	title="Início"
	description="Conteúdo sobre podcasting, produção musical, masterização e equipamentos de áudio."
	jsonLd={jsonLd}
>
	<!-- hero -->
	<section class="mb-12 text-center sm:text-left rise-in">
		<span class="badge-soft">
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>
			Blog da Speake
		</span>
		<h1 class="font-display font-semibold text-4xl sm:text-5xl mt-4 leading-[1.1]">
			Notas de estúdio<br class="hidden sm:block" /> sobre <span class="text-aurora">áudio</span>
		</h1>
		<p class="text-ink-soft leading-relaxed mt-4 max-w-xl mx-auto sm:mx-0 text-base sm:text-lg">
			Guias práticos de podcasting, produção musical, masterização e equipamentos —
			escritos por quem grava, mixa e publica.
		</p>
		<p class="font-mono-panel text-xs text-ink-faint mt-5">
			{posts.length} artigos · {tagsWithCount.length} temas · atualizado sempre
		</p>
	</section>

	<!-- tags -->
	<section class="mb-10 rise-in rise-in--2" aria-labelledby="tags-heading">
		<h2 id="tags-heading" class="t-micro text-ink-faint mb-3">
			Navegar por tema
		</h2>
		<div class="flex flex-wrap gap-2 justify-center sm:justify-start">
			{tagsWithCount.map(({ tag, count }) => <TagBadge tag={tag} count={count} />)}
		</div>
	</section>

	<!-- posts -->
	<section class="rise-in rise-in--3" aria-labelledby="posts-heading">
		<h2 id="posts-heading" class="t-micro text-ink-faint mb-4">
			Posts recentes
		</h2>
		<SearchFilter />
		<div class="grid gap-5 sm:grid-cols-2">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
