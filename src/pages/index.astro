---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagBadge from '../components/TagBadge.astro';
import SearchFilter from '../components/SearchFilter.astro';
import { AUDIO_TAGS } from '../content.config';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tagsWithCount = AUDIO_TAGS.filter((tag) => tagCounts.has(tag)).map((tag) => ({
	tag,
	count: tagCounts.get(tag) ?? 0,
}));
---

<BaseLayout
	title="Início"
	description="Conteúdo sobre podcasting, produção musical, masterização e equipamentos de áudio."
>
	<section class="mb-10">
		<h1 class="font-serif-editorial text-3xl mb-3 text-studio-text">
			Notas de estúdio sobre áudio
		</h1>
		<p class="text-studio-text-muted leading-relaxed">
			Guias práticos de podcasting, produção musical, masterização e equipamentos —
			escritos por quem grava, mixa e publica.
		</p>
	</section>

	<section class="mb-10" aria-labelledby="tags-heading">
		<h2 id="tags-heading" class="font-mono-panel text-xs uppercase tracking-wide text-studio-text-muted mb-3">
			Navegar por tag
		</h2>
		<div class="flex flex-wrap gap-2">
			{tagsWithCount.map(({ tag, count }) => <TagBadge tag={tag} count={count} />)}
		</div>
	</section>

	<section aria-labelledby="posts-heading">
		<h2 id="posts-heading" class="font-mono-panel text-xs uppercase tracking-wide text-studio-text-muted mb-4">
			Posts recentes
		</h2>
		<SearchFilter />
		<div class="grid gap-4">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
