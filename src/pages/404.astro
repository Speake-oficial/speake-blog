---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

// Página 404 do site. A Vercel serve `404.html` automaticamente, com status 404,
// para qualquer caminho que não exista no build estático.
//
// O par desta página para agentes é o corpo Markdown devolvido pelo middleware
// quando o request pede `Accept: text/markdown` — ver middleware.ts e
// `notFoundMarkdown` em src/lib/agentMarkdown.ts. Os dois dizem a mesma coisa:
// o que aconteceu, e por onde seguir.

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latest = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout
	title="Página não encontrada"
	description="O endereço pedido não existe no Speake Blog. Veja os artigos mais recentes ou navegue pelas categorias."
>
	<p class="t-micro text-ink-faint mb-3 rise-in">Erro 404</p>
	<h1 class="font-display font-semibold text-3xl sm:text-4xl mb-3 rise-in">
		Essa faixa não existe
	</h1>
	<p class="text-ink-soft leading-relaxed mb-8 max-w-xl rise-in">
		O endereço que você pediu não está publicado aqui — pode ter sido removido, renomeado
		ou digitado errado. Abaixo estão os caminhos de volta.
	</p>

	<div class="flex flex-wrap gap-3 mb-14 rise-in rise-in--2">
		<a href="/" class="btn btn--primary btn--sm">Ir para o início</a>
		<a href="/tags/" class="btn btn--outline btn--sm">Ver categorias</a>
		<a href="/contact/" class="btn btn--outline btn--sm">Avisar sobre um link quebrado</a>
	</div>

	<h2 class="font-display font-semibold text-xl mb-5 rise-in rise-in--2">Artigos mais recentes</h2>
	<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 rise-in rise-in--2">
		{latest.map((post) => (
			<li><PostCard post={post} /></li>
		))}
	</ul>
</BaseLayout>
