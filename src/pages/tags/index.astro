---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { AUDIO_TAGS } from '../../content.config';
import { getTagLabel } from '../../lib/tagLabels';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tagsWithCount = AUDIO_TAGS.filter((tag) => tagCounts.has(tag))
	.map((tag) => ({ tag, count: tagCounts.get(tag) ?? 0 }))
	.sort((a, b) => b.count - a.count);
---

<BaseLayout title="Categorias" description="Todas as categorias do blog e quantidade de posts em cada uma.">
	<Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Categorias' }]} />

	<h1 class="font-display font-semibold text-3xl sm:text-4xl mb-3 rise-in">Categorias</h1>
	<p class="text-ink-soft leading-relaxed mb-8 max-w-xl rise-in">
		Todo o conteúdo do blog, organizado por assunto — de captação a masterização.
	</p>

	<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 rise-in rise-in--2">
		{tagsWithCount.map(({ tag, count }) => (
			<li>
				<a
					href={`/tags/${tag}/`}
					class="sheet sheet--hover relative block p-6 h-full"
				>
					<h2 class="font-display font-semibold text-lg leading-snug">{getTagLabel(tag)}</h2>
					<p class="font-mono-panel text-[0.6875rem] tracking-[0.08em] uppercase text-ink-faint mt-2">
						{count} {count === 1 ? 'faixa' : 'faixas'}
					</p>
				</a>
			</li>
		))}
	</ul>
</BaseLayout>
