---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagBadge from '../../components/TagBadge.astro';
import { AUDIO_TAGS } from '../../content.config';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tagsWithCount = AUDIO_TAGS.filter((tag) => tagCounts.has(tag))
	.map((tag) => ({ tag, count: tagCounts.get(tag) ?? 0 }))
	.sort((a, b) => b.count - a.count);
---

<BaseLayout title="Tags" description="Todas as tags do blog e quantidade de posts em cada uma.">
	<Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Tags' }]} />

	<h1 class="font-serif-editorial text-3xl mb-6">Tags</h1>

	<ul class="flex flex-wrap gap-2">
		{tagsWithCount.map(({ tag, count }) => (
			<li>
				<TagBadge tag={tag} count={count} />
			</li>
		))}
	</ul>
</BaseLayout>
