---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagBadge from '../../components/TagBadge.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CategoryList from '../../components/CategoryList.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getTagLabel } from '../../lib/tagLabels';
import { extractFaq } from '../../lib/faq';
import { formatPostDate } from '../../lib/formatDate';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formattedDate = formatPostDate(post.data.pubDate);

const primaryTag = post.data.tags[0];

const updatedDate = post.data.updatedDate;
const formattedUpdatedDate = updatedDate ? formatPostDate(updatedDate) : undefined;

const author = post.data.author;

const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

// Mesma troca SVG→PNG feita no BaseLayout: o Google exige raster (jpg/png/webp)
// nas imagens de Article para elegibilidade a rich results.
const rawImage = post.data.image?.src.src;
const ogImagePath = rawImage?.endsWith('.svg')
	? `/og/${rawImage.split('/').pop()!.split('.')[0]}.png`
	: rawImage;

const publisher = {
	'@type': 'Organization',
	'@id': 'https://speake.com.br/#organization',
	name: 'Speake',
	url: 'https://speake.com.br',
	logo: {
		'@type': 'ImageObject',
		url: new URL('/icon-512.png', Astro.site ?? Astro.url.origin).toString(),
		width: 512,
		height: 512,
	},
};

// Autor nomeado (frontmatter `author`) vira Person e vence a atribuição
// institucional; sem ele, cai no Organization de antes.
const authorNode = author
	? {
			'@type': 'Person',
			name: author.name,
			...(author.url ? { url: author.url } : {}),
			...(author.jobTitle ? { jobTitle: author.jobTitle } : {}),
			worksFor: { '@type': 'Organization', name: 'Speake', url: 'https://speake.com.br' },
		}
	: { '@type': 'Organization', name: 'Speake', url: 'https://speake.com.br' };

// `dateModified` sempre presente: sem edição registrada ele coincide com a
// publicação, que é a informação correta — a ausência da propriedade é lida como
// dado faltando, não como "nunca mudou".
const jsonLdPost = {
	'@type': 'BlogPosting',
	'@id': `${canonicalURL}#article`,
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	dateModified: (updatedDate ?? post.data.pubDate).toISOString(),
	mainEntityOfPage: canonicalURL,
	url: canonicalURL,
	inLanguage: 'pt-BR',
	image: new URL(ogImagePath ?? '/og-default.png', Astro.site ?? Astro.url.origin).toString(),
	keywords: post.data.tags.map(getTagLabel).join(', '),
	...(primaryTag ? { articleSection: getTagLabel(primaryTag) } : {}),
	wordCount,
	timeRequired: `PT${readingMinutes}M`,
	author: authorNode,
	publisher,
};

// FAQPage a partir da seção "Perguntas frequentes" do próprio markdown, quando
// existir. Marcar as perguntas que já estão escritas é o que as torna extraíveis
// como par pergunta/resposta por buscador e por motor generativo.
const faqEntries = extractFaq(post.body ?? '');
const jsonLdFaq =
	faqEntries.length > 0
		? {
				'@type': 'FAQPage',
				'@id': `${canonicalURL}#faq`,
				inLanguage: 'pt-BR',
				mainEntity: faqEntries.map((entry) => ({
					'@type': 'Question',
					name: entry.question,
					acceptedAnswer: { '@type': 'Answer', text: entry.answer },
				})),
			}
		: null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [jsonLdPost, ...(jsonLdFaq ? [jsonLdFaq] : [])],
};
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	type="article"
	image={post.data.image?.src.src}
	imageAlt={post.data.image?.alt}
	publishedTime={post.data.pubDate}
	modifiedTime={updatedDate}
	tags={post.data.tags}
	jsonLd={jsonLd}
	wide
>
	<Breadcrumbs
		items={[
			{ label: 'Início', href: '/' },
			{ label: 'Categorias', href: '/tags' },
			...(primaryTag ? [{ label: getTagLabel(primaryTag), href: `/tags/${primaryTag}/` }] : []),
			{ label: post.data.title },
		]}
	/>

	<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_264px] lg:gap-8 lg:items-start">
		<div class="min-w-0">
			<article class="sheet overflow-hidden rise-in">
				{post.data.image && (
					<img
						src={post.data.image.src.src}
						alt={post.data.image.alt}
						class="w-full aspect-[1200/630] object-cover border-b border-(--line)"
					/>
				)}

				<div class="px-5 py-8 sm:px-10 sm:py-10">
					<header class="mb-8 max-w-[70ch]">
						<p class="font-mono-panel text-[0.6875rem] tracking-[0.08em] uppercase text-ink-faint flex flex-wrap items-center gap-x-2 gap-y-1 mb-4">
							{primaryTag && (
								<a href={`/tags/${primaryTag}/`} class="text-signal font-semibold hover:underline underline-offset-2">
									{getTagLabel(primaryTag)}
								</a>
							)}
							<span aria-hidden="true" class="text-(--line-strong)">|</span>
							<time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
							<span aria-hidden="true" class="text-(--line-strong)">|</span>
							<span>{readingMinutes} min de leitura</span>
						</p>
						<h1 class="font-display font-semibold text-3xl sm:text-4xl leading-[1.1] mb-4">
							{post.data.title}
						</h1>
						<p class="text-ink-soft leading-relaxed text-base sm:text-lg mb-5">
							{post.data.description}
						</p>
						<p class="font-mono-panel text-xs text-ink-faint flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-b border-(--line) py-3">
							<span>
								Por {author?.url ? <a href={author.url} rel="author" class="text-(--link) font-semibold underline underline-offset-2">{author.name}</a> : (author?.name ?? 'Speake')}
							</span>
							{updatedDate && (
								<>
									<span aria-hidden="true">·</span>
									<span>
										atualizado em <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
									</span>
								</>
							)}
						</p>
					</header>

					{tocItems.length > 0 && (
						<details class="lg:hidden sheet !rounded-xl px-4 py-3 mb-8">
							<summary class="t-micro text-ink-soft cursor-pointer select-none">Neste artigo</summary>
							<div class="pt-3">
								<TableOfContents headings={headings} />
							</div>
						</details>
					)}

					<div class="prose-speake max-w-[70ch]">
						<Content />
					</div>

					<footer class="max-w-[70ch] mt-10">
						<p class="t-micro text-ink-faint mb-3">Categorias deste artigo</p>
						<div class="flex flex-wrap gap-1.5">
							{post.data.tags.map((tag) => <TagBadge tag={tag} />)}
						</div>
					</footer>
				</div>
			</article>

			<RelatedPosts current={post} />

			<!-- CTA institucional: bloco chapado violeta profundo, sem gradiente.
			     A copy oferece a PLATAFORMA, não serviço de produção. Ela dizia
			     "A Speake produz podcast, narração e áudio publicitário de ponta a
			     ponta" — em prosa, no rodapé de todos os posts. Era a afirmação
			     sobre a marca com mais alcance em todo o domínio, e contradizia o
			     site principal, o JSON-LD e o llms.txt ao mesmo tempo. -->
			<aside class="deep mt-10 px-6 py-8 sm:px-10 rise-in" aria-label="Conheça a Speake">
				<div class="flex flex-col sm:flex-row sm:items-center gap-6 justify-between">
					<div>
						<p class="t-micro text-white/45 mb-2">Da casa</p>
						<h2 class="font-display font-semibold text-2xl text-white">
							E depois de gravar, onde publicar?
						</h2>
						<p class="text-white/75 text-sm sm:text-base leading-relaxed mt-2 max-w-md">
							A Speake é a plataforma onde criadores publicam episódios exclusivos numa
							estação e a audiência assina para ouvir. Grava pelo app, sem hospedar feed
							RSS em outro serviço.
						</p>
					</div>
					<a
						href="https://speake.com.br"
						target="_blank"
						rel="noopener"
						class="btn btn--primary shrink-0"
					>
						Conhecer a Speake
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
				</div>
			</aside>
		</div>

		<!-- sidebar fixa: sumário + categorias (desktop) -->
		<aside class="hidden lg:block sticky top-24 space-y-4 rise-in rise-in--2" aria-label="Navegação do artigo">
			{tocItems.length > 0 && (
				<div class="sheet p-5">
					<p class="t-micro text-ink-faint mb-3">Neste artigo</p>
					<TableOfContents headings={headings} />
				</div>
			)}
			<div class="sheet p-5">
				<p class="t-micro text-ink-faint mb-3">Categorias</p>
				<CategoryList currentTag={primaryTag} />
			</div>
		</aside>
	</div>
</BaseLayout>
